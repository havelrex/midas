{
  "name": "snapscore-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "analyze:photo": "tsx scripts/analyze-photo.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "checkout:demo": "tsx src/checkout/demo.ts",
    "try:reviews": "tsx scripts/try.ts reviews",
    "try:timing": "tsx scripts/try.ts timing",
    "try:quality": "tsx scripts/try.ts quality",
    "try:price": "tsx scripts/try.ts price",
    "try:score": "tsx scripts/try.ts score",
    "try:live": "tsx scripts/try.ts live",
    "try:demo": "tsx scripts/try.ts demo",
    "cache:clear": "node -e \"require('fs').rmSync('data/cache',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
