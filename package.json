{
  "name": "snapscore",
  "version": "0.1.0",
  "private": true,
  "description": "Snap a photo of a product and get a single 0-100 score with an actionable verdict: Buy now, Wait, Skip, or Sell for $X.",
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client --tunnel",
    "start:camera": "expo start --dev-client --tunnel=ngrok",
    "ios": "expo start --dev-client --ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stripe/stripe-react-native": "0.81.0",
    "@supabase/supabase-js": "^2.118.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~58.0.14",
    "expo-camera": "~58.0.10",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-image-manipulator": "~58.0.14",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
