# Server Configuration
PORT=4000

# Gemini API (Vision product identification & review durability mining)
GEMINI_API_KEY=your_gemini_api_key_here

# SerpAPI (Google Shopping listings for Buy mode)
SERPAPI_KEY=your_serpapi_key_here

# eBay Browse API (Active & sold listings for Buy/Sell modes)
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here

# Keepa API (90-day Amazon price history)
KEEPA_API_KEY=your_keepa_api_key_here

# Supabase (Users, price alerts, and historical price logs)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-only: bypasses RLS (automation, purchase updates). Never expose to mobile.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Mobile App (Expo)
EXPO_PUBLIC_API_URL=http://localhost:4000
# 1 = Library, Item Detail and Profile counts show sample items (UI work before /score exists). Never on for the demo.
EXPO_PUBLIC_MOCK_LIBRARY=0
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Stripe sandbox only. All three keys and the Supabase service role enable checkout.
# Leave blank until configured; existing API features continue to work.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Alternatively, the existing EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY is accepted.
STRIPE_WEBHOOK_SECRET=
# Poll sandbox watches every 10 seconds while the backend is running.
CHECKOUT_WATCHER_ENABLED=true

# Scoring (server)
# Reuse listings, reviews, and quality results for this many minutes (default 60).
# Raise it and scan an item once before a demo to freeze it.
SCORE_CACHE_TTL_MINUTES=60
# true adds the sandbox merchant listing, enables POST /demo/price-drop, and enables the operator's
# manual sandbox price-change command (not payments).
DEMO_MODE=false
