{
  "expo": {
    "name": "Midas",
    "slug": "snapscore",
    "version": "1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.havelrex.snapscore",
      "buildNumber": "2"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Midas to use the camera to identify products.",
          "barcodeScannerEnabled": false
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false,
          "disableSPM": true
        }
      ]
    ]
  }
}
