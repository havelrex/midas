{
  "expo": {
    "name": "Snap & Score",
    "slug": "snapscore",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.havelrex.snapscore"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Snap & Score to use the camera to identify products.",
          "barcodeScannerEnabled": false
        }
      ]
    ]
  }
}
